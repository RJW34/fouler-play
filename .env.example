# ==============================================================================
# Fouler Play - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your specific values. Run one supervised
# Fouler runtime per host; DEKU owns Discord identity and network delivery.
# ==============================================================================

# === REQUIRED: Pokemon Showdown Credentials ===
PS_USERNAME=YOUR_USERNAME_HERE
PS_PASSWORD=YOUR_PASSWORD_HERE

# Pokemon Showdown WebSocket URI
# Default: wss://sim3.psim.us/showdown/websocket
PS_WEBSOCKET_URI=wss://sim3.psim.us/showdown/websocket

# Battle format to play (e.g., gen9ou, gen9randombattle, gen8ou)
PS_FORMAT=gen9ou

# Bot mode (used by run.py if passed via environment instead of CLI)
# Options: search_ladder, challenge_user, accept_challenge
PS_BOT_MODE=search_ladder

# How long to search for each move (milliseconds)
# Lower = faster decisions, higher = potentially better play
# Recommended: 2000-3000ms for ladder play
PS_SEARCH_TIME_MS=2000

# === Decision Policy (Eval vs Hybrid) ===
# DECISION_POLICY:
# - eval   = existing deterministic eval/heuristic policy only
# - hybrid = eval generates candidates, OpenAI reranks among top candidates
DECISION_POLICY=eval

# OpenAI key used for live hybrid decisions (required when DECISION_POLICY=hybrid)
OPENAI_API_KEY_PLAYER=

# OpenAI key reserved for learner/offline analysis jobs (optional)
# Keep this separate from live ladder credentials when experimenting with offline workflows.
OPENAI_API_KEY_LEARNER=

# Backward-compatible single key alias (used if OPENAI_API_KEY_PLAYER is unset)
OPENAI_API_KEY=

# OpenAI model for hybrid reranking
OPENAI_MODEL=gpt-4.1-mini

# Optional custom API base (default works for OpenAI cloud)
OPENAI_API_BASE=https://api.openai.com/v1

# LLM rerank call timeout in seconds (keep low to avoid turn timer pressure)
LLM_TIMEOUT_SEC=3.0

# Number of top eval candidates provided to the LLM for reranking
LLM_RERANK_TOP_K=5

# Hybrid request backoff (seconds) after API 429 rate-limit responses
HYBRID_RATE_LIMIT_BACKOFF_SEC=120

# Skip LLM rerank on clear-best turns to save tokens/rate-limit budget.
# Rerank only when top choices are close.
HYBRID_CLEAR_BEST_RATIO=1.35
HYBRID_CLEAR_BEST_DELTA=0.15

# Production batches are finite and lease-bound. The pilot judgment window is
# 30 decisive battles: 10 per benchmark team.
PS_RUN_COUNT=30

# === Team Configuration ===
# TEAM_LIST: Path to file containing team paths (one per line)
# Example: fat-teams.list contains paths like "gen9/ou/fat-team-1-stall"
# TEAM_LIST=fat-teams.list

# TEAM_NAME: Single team to use (mutually exclusive with TEAM_LIST)
# TEAM_NAME=gen9/ou/fat-team-1-stall

# TEAM_NAMES: Comma-separated list for per-worker team assignment
TEAM_NAMES=gen9/ou/fat-team-1-stall,gen9/ou/fat-team-2-balance,gen9/ou/fat-team-3-dondozo

# === Battle Parallelization ===
# Owner-locked pilot concurrency: one account, three simultaneous battles.
MAX_CONCURRENT_BATTLES=3

# Owner-locked MCTS parallelism for the live pilot.
SEARCH_PARALLELISM=2

# === Logging Configuration ===
# Log level for console output
# Options: DEBUG, INFO, WARNING, ERROR
BOT_LOG_LEVEL=INFO

# Whether to write logs to files (1=yes, 0=no)
# Logs are written to logs/ directory with rotation (10MB max, 3 backups)
BOT_LOG_TO_FILE=1

# === DEKU Event Reporting ===
# This label is local runtime metadata. It is not a Discord sender identity.
BOT_DISPLAY_NAME=Fouler Play

# All reports enter DEKU's durable event queue. Direct Discord webhooks are not
# part of the supported runtime contract.
DEKU_EVENT_QUEUE_ROOT=D:\DekuEvents

# Every completed battle becomes one stable, non-command DEKU observation. The
# global HERMES relay is the only component that may deliver it to Discord.
EVENT_POSTER_EXPIRY_SEC=21600
FOULER_BATCH_SIZE=30

# === Recursive Engine Improvement (Explicit Opt-In) ===
# Keep parked until the candidate-vs-frozen harness has current operational
# proof. The weak simple-opponent evaluator cannot authorize promotion.
# The head-to-head harness spends at most five p<0.01 attempts per evaluated
# runtime family. Its immutable authority is fixed outside the repo at
# ~/.deku/state/fouler-h2h-ledger-authority.json and is not environment-configurable.
# Provision it once with `head_to_head_eval.py --initialize-ledger --ledger-id <id>`.
FOULER_PLAY_ENABLE_AUTO_IMPROVE=0
# Required only when auto-improve is explicitly enabled. This must name a separate,
# pre-staged DEKU-signed v3 lease whose exact purpose is `improve-agent`.
FOULER_IMPROVE_RUNTIME_LEASE_PATH=
FOULER_ACCEPTED_COMMIT_RECEIPT_ROOT=~/.deku/state/fouler/accepted-commits
IMPROVE_AGENT_EVAL_GATE=1
IMPROVE_AGENT_EVAL_BATTLES=60
IMPROVE_AGENT_EVAL_TEAMS=gen9/ou/fat-team-1-stall,gen9/ou/fat-team-2-balance,gen9/ou/fat-team-3-dondozo
IMPROVE_AGENT_EVAL_SHOWDOWN_PORT=8791
IMPROVE_AGENT_EVAL_SEARCH_TIME_MS=1200
IMPROVE_AGENT_EVAL_PER_BATTLE_TIMEOUT=240
IMPROVE_AGENT_TEST_TIMEOUT_SECONDS=360

# === Process Management (Advanced) ===
# Parent process PID (used only by canonical managed child processes)
# FP_PARENT_PID=12345

# How often to check if parent is alive (seconds)
# FP_PARENT_CHECK_SEC=5

# Enable automatic drain mode after losses
# When enabled, bot stops queueing new battles after a loss
# Options: 1, true, yes (enabled) or 0, false, no (disabled)
LOSS_TRIGGERED_DRAIN=1

# Timeout for drain mode to complete (seconds)
# DRAIN_TIMEOUT_SEC=300

# Hard stop for a single battle in seconds.
# Set to 0 to never force-terminate long stall games (recommended for evaluation).
BATTLE_HARD_TIMEOUT_SEC=0

# === OBS Spectator Account (Optional) ===
# Separate PS account to use for spectating in OBS
# If set, OBS should log into this account instead of the bot account
# This prevents OBS from auto-switching to the bot's active battle
SPECTATOR_USERNAME=

# Disable stream hooks by default for user-only bot play
ENABLE_STREAM_HOOKS=0

# End-of-battle Showdown chat policy.
# Production defaults to an opt-in, rate-limited "gg". The historical
# live-only promo capability remains fail-closed behind a separate approval
# gate; do not enable it without written platform authorization.
FOULER_POST_BATTLE_CHAT_ENABLED=0
FOULER_POST_BATTLE_CHAT_COOLDOWN_BATTLES=12
POST_BATTLE_GG_MESSAGE=gg
FOULER_POST_BATTLE_PROMO_AUTHORIZED=0
POST_BATTLE_LIVE_PROMO_MESSAGE=twitch.tv/thepeakmos
# Configure one DEKU-managed dynamic JSON or HTTP stream-truth source only
# after authorization. Static FOULER_DEVSTREAM_LIVE overrides are ignored.
# FOULER_DEVSTREAM_STATUS_JSON=<protected OBS stream-truth JSON>
# FOULER_DEVSTREAM_STATUS_URL=<DEKU live-metrics JSON URL>

# Invites are enabled automatically when SPECTATOR_USERNAME is set.
# Set this to 0/false/no/off only if you want to explicitly disable invites.
ENABLE_SPECTATOR_INVITES=1

# OBS HTTP lifecycle belongs to the HERMES-FoulerObsServer Windows service.
# Battle sessions must not spawn a second helper server.
AUTO_START_OBS_SERVER=0

# === Session Management (Advanced) ===
# Whether to resume active battles on restart
# SESSION_REBASE_ON_START=1

# A second ladder account requires a separate supervised deployment and queue
# namespace. It must not reuse DEKU's identity or add a direct Discord webhook.
