{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fouler-play.local/schemas/elo-proof.schema.json",
  "title": "fouler-play 1700 sustained ELO proof",
  "type": "object",
  "required": ["schemaVersion", "format", "sourceCommit", "account", "target", "session", "games", "analysis", "summary"],
  "properties": {
    "schemaVersion": {"const": "fouler-play-elo-proof/v1"},
    "format": {"const": "gen9ou"},
    "sourceCommit": {"type": "string", "minLength": 7},
    "source": {
      "type": "object",
      "properties": {
        "sourceCommit": {"type": "string", "minLength": 7},
        "generatedBy": {"type": "string"}
      },
      "additionalProperties": true
    },
    "account": {
      "type": "object",
      "required": ["showdownUserId"],
      "properties": {
        "showdownUserId": {"type": "string"},
        "ratingSource": {"type": "string"}
      },
      "additionalProperties": true
    },
    "target": {
      "type": "object",
      "required": [
        "ratingFloor",
        "minimumCompletedGames",
        "sustainMinimumGames",
        "sustainMinimumGamesPerTeam",
        "maximumSustainDrawdown",
        "maximumPreTargetDrawdown",
        "minimumSustainWinRate",
        "requiredTeams",
        "noCherryPicking",
        "uninterruptedPostTargetFloorRequired"
      ],
      "properties": {
        "ratingFloor": {"type": "integer", "minimum": 1000},
        "minimumCompletedGames": {"type": "integer", "minimum": 1},
        "sustainMinimumGames": {"type": "integer", "minimum": 1},
        "sustainMinimumGamesPerTeam": {"type": "integer", "minimum": 1},
        "maximumSustainDrawdown": {"type": "number", "minimum": 0},
        "maximumPreTargetDrawdown": {"type": "number", "minimum": 0},
        "minimumSustainWinRate": {"type": "number", "minimum": 0, "maximum": 1},
        "requiredTeams": {"type": "array", "items": {"type": "string"}},
        "opponentBand": {"type": "string"},
        "noCherryPicking": {"type": "boolean"},
        "uninterruptedPostTargetFloorRequired": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "session": {
      "type": "object",
      "required": ["startedAt", "endedAt", "runCountTarget"],
      "properties": {
        "startedAt": {"type": ["string", "null"]},
        "endedAt": {"type": ["string", "null"]},
        "runCountTarget": {"type": "integer"},
        "maxConcurrentBattles": {"type": "integer"}
      },
      "additionalProperties": true
    },
    "games": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["battleId", "result", "replayUrl"],
        "properties": {
          "battleId": {"type": "string"},
          "result": {"enum": ["win", "loss", "draw", "forfeit", "unknown"]},
          "replayUrl": {"type": "string"},
          "opponent": {"type": "string"},
          "opponentRating": {"type": ["integer", "null"]},
          "ratingBefore": {"type": ["integer", "null"]},
          "ratingAfter": {"type": ["integer", "null"]},
          "teamFile": {"type": "string"},
          "decisionTracePath": {"type": "string"},
          "decisionTraceUrl": {"type": "string"},
          "failureClasses": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "analysis": {
      "type": "object",
      "required": ["autoresearchJsonPath", "autoresearchReportPath", "decisionTraceReviewPath"],
      "properties": {
        "generatedAtUtc": {"type": "string"},
        "autoresearchJsonPath": {"type": "string"},
        "autoresearchReportPath": {"type": "string"},
        "decisionTraceReviewPath": {"type": "string"},
        "topIssue": {"type": "string"},
        "reviewedBattleCount": {"type": "integer"},
        "lossesAnalyzed": {"type": "integer"}
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "completedGames",
        "wins",
        "losses",
        "peakRating",
        "finalRating",
        "passesTarget",
        "sustainedTarget",
        "sustainWindowGames",
        "gamesAtOrAboveFloor",
        "belowFloorAfterFirstTarget",
        "maxSustainDrawdown",
        "preTargetRatedGames",
        "maxPreTargetDrawdown",
        "sustainReplayProofCount",
        "missingSustainReplayCount",
        "mismatchedSustainReplayCount",
        "missingSustainBattleIdCount",
        "duplicateSustainBattleIdCount",
        "duplicateSustainReplayIdCount",
        "unknownSustainTeamCount",
        "decisionTraceProofCount",
        "missingDecisionTraceCount",
        "duplicateDecisionTraceProofCount",
        "duplicateDecisionTraceProofs",
        "missingBattleTimestampCount",
        "outOfOrderBattleTimestampCount",
        "chronologicalBattleOrderComplete",
        "analysisEvidenceComplete",
        "sustainEvidenceShapeComplete",
        "sustainProofComplete",
        "teamCoverage"
      ],
      "properties": {
        "completedGames": {"type": "integer"},
        "wins": {"type": "integer"},
        "losses": {"type": "integer"},
        "peakRating": {"type": ["integer", "null"]},
        "finalRating": {"type": ["integer", "null"]},
        "passesTarget": {"type": "boolean"},
        "sustainedTarget": {"type": "boolean"},
        "sustainWindowGames": {"type": "integer"},
        "gamesAtOrAboveFloor": {"type": "integer"},
        "belowFloorAfterFirstTarget": {"type": "integer"},
        "maxSustainDrawdown": {"type": ["number", "null"]},
        "preTargetRatedGames": {"type": "integer"},
        "maxPreTargetDrawdown": {"type": ["number", "null"]},
        "preTargetDrawdownPeakRating": {"type": ["integer", "number", "null"]},
        "preTargetDrawdownPeakBattleId": {"type": ["string", "null"]},
        "preTargetDrawdownTroughRating": {"type": ["integer", "number", "null"]},
        "preTargetDrawdownTroughBattleId": {"type": ["string", "null"]},
        "preTargetDrawdownWithinLimit": {"type": "boolean"},
        "sustainReplayProofCount": {"type": "integer"},
        "missingSustainReplayCount": {"type": "integer"},
        "missingSustainReplayBattleIds": {"type": "array", "items": {"type": "string"}},
        "mismatchedSustainReplayCount": {"type": "integer"},
        "mismatchedSustainReplayBattleIds": {"type": "array", "items": {"type": "string"}},
        "missingSustainBattleIdCount": {"type": "integer"},
        "duplicateSustainBattleIdCount": {"type": "integer"},
        "duplicateSustainBattleIds": {"type": "array", "items": {"type": "string"}},
        "duplicateSustainReplayIdCount": {"type": "integer"},
        "duplicateSustainReplayIds": {"type": "array", "items": {"type": "string"}},
        "unknownSustainTeamCount": {"type": "integer"},
        "unknownSustainTeamBattleIds": {"type": "array", "items": {"type": "string"}},
        "decisionTraceProofCount": {"type": "integer"},
        "missingDecisionTraceCount": {"type": "integer"},
        "missingDecisionTraceBattleIds": {"type": "array", "items": {"type": "string"}},
        "duplicateDecisionTraceProofCount": {"type": "integer"},
        "duplicateDecisionTraceProofs": {"type": "array", "items": {"type": "string"}},
        "missingBattleTimestampCount": {"type": "integer"},
        "missingBattleTimestampBattleIds": {"type": "array", "items": {"type": "string"}},
        "outOfOrderBattleTimestampCount": {"type": "integer"},
        "outOfOrderBattleTimestampBattleIds": {"type": "array", "items": {"type": "string"}},
        "chronologicalBattleOrderComplete": {"type": "boolean"},
        "analysisEvidenceComplete": {"type": "boolean"},
        "sustainEvidenceShapeComplete": {"type": "boolean"},
        "sustainProofComplete": {"type": "boolean"},
        "teamCoverage": {"type": "object"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
